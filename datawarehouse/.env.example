# Local execution only: never commit populated .env or static AWS keys.
# EC2 runtime.py reads MYSQL_SECRET_ARN/MONGO_SECRET_ARN/REDSHIFT_SECRET_ARN
# (username/password only) and separate PREFIX_HOST/PORT/DATABASE from runtime.json.
# MONGO_URI is constructed in memory with escaped credentials and authSource=admin.
# Local direct execution uses the resolved variables below; both CA files are required.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=ecommerce
MYSQL_SSL_CA=/opt/ecommerce/certs/global-bundle.pem
# Local URI: mongodb://ENCODED_USER:ENCODED_PASSWORD@HOST:27017/ecommerce?authSource=admin&tls=true&replicaSet=rs0&retryWrites=false
MONGO_URI=
MONGO_DATABASE=ecommerce
MONGO_TLS_CA_FILE=/opt/ecommerce/certs/global-bundle.pem
AWS_REGION=us-east-1
S3_BUCKET=
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=ecommerce_dw
REDSHIFT_USER=admin
REDSHIFT_PASSWORD=
REDSHIFT_COPY_ROLE_ARN=
PGSSLROOTCERT=/opt/ecommerce/certs/redshift-ca.crt
DBT_BIN=/opt/ecommerce/dbt/bin/dbt
DBT_PROJECT_DIR=/opt/ecommerce/app/dbt
DBT_PROFILES_DIR=/opt/ecommerce/app/dbt
DW_PYTHON=/opt/ecommerce/runtime/bin/python
